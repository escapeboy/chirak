APP_NAME=Chirak
APP_ENV=production
APP_DEBUG=false
APP_URL=https://chirak.fleetq.net
APP_KEY=
LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
CHIRAK_READONLY=1
CHIRAK_PLAYGROUND_NOTE=
# playground open without the demo token: 5 compares a minute per address, 6 a minute for all visitors together
CHIRAK_PLAYGROUND_PUBLIC=1
CHIRAK_PLAYGROUND_PER_MINUTE=5
DEMO_TOKEN=
WORKER_BEARER_TOKEN=
# the subnet of the `proxy` network in docker-compose.yml (the shared nginx-proxy's address there)
TRUSTED_PROXIES=10.231.7.0/24
# for docker compose itself
SERVED_NAME=
TUNED_GGUF=
