# CPU playground front: the worker's /predict contract over llama.cpp servers (chirak_worker.cpu_predict).
FROM python:3.12-slim
RUN pip install --no-cache-dir fastapi==0.143.0 uvicorn==0.54.0 httpx==0.28.1 pydantic==2.14.1
WORKDIR /srv
COPY worker/chirak_worker ./chirak_worker
USER nobody
CMD ["python", "-m", "chirak_worker.cpu_predict", "serve", "--host", "0.0.0.0", "--port", "8100"]
