APP_NAME=Chirak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# docker compose up -d (see docker-compose.yml)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=33071
DB_DATABASE=chirak
DB_USERNAME=chirak
DB_PASSWORD=chirak

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63801

# GPU worker (reached through an SSH tunnel), see docs/worker-api.md
WORKER_BASE_URL=http://127.0.0.1:8100
WORKER_BEARER_TOKEN=

# Orchestrator (Claude failure analysis)
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-sonnet-5-5

# Starting a run / approving / playground actions require this token
DEMO_TOKEN=

# Sentry (self-hosted, sentry.karlovo.net, project chirak). Leave empty to disable.
# DSN is in 1Password vault "AI Agent", item "Chirak Sentry", field dsn.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
